local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local DoorSystemEvent = ReplicatedStorage:WaitForChild("DoorSystemEvent")

-- Ссылка на уже готовый GUI (созданный в StarterGui)
local gui = script.Parent -- Это и есть TeleportGUI
local frame = gui:FindFirstChild("MainFrame")
if not frame then
	warn("Ошибка: не найден Frame с именем MainFrame внутри TeleportGUI. Создай его вручную в StarterGui.")
	return
end

local function teleportTo(x, y, z)
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")
	root.CFrame = CFrame.new(x, y, z)
end

-- Таблица кнопок для хранения ссылок и таймеров
local buttons = {}
local timerConnections = {}

local function updateButtonTimer(btn, timeLeft)
	if timeLeft <= 0 then
		btn.Text = "🚪 Дверь открыта!"
		btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Зелёный
	else
		local mins = math.floor(timeLeft / 60)
		local secs = timeLeft % 60
		btn.Text = string.format("🚪 Откроется через: %02d:%02d", mins, secs)
		btn.BackgroundColor3 = Color3.fromRGB(200, 100, 0) -- Оранжевый
	end
end

-- Функция, которая связывает кнопку с ID двери
local function linkButton(btn, doorId)
	buttons[doorId] = btn
	
	btn.Activated:Connect(function()
		-- Запрос на телепорт серверу
		DoorSystemEvent:FireServer("requestTeleport", {doorId = doorId})
	end)
end

-- Связываем существующие кнопки с ID дверей
-- Важно: имена кнопок должны совпадать с тем, как ты их создал в StarterGui
-- Например, кнопка "Дом 1" должна иметь имя "BtnDoor1" или похожее
local allButtons = frame:GetDescendants()
for _, obj in ipairs(allButtons) do
	if obj:IsA("TextButton") then
		local id = tonumber(obj.Name:match("BtnDoor(%d+)"))
		if id then
			linkButton(obj, id)
		end
		
		-- Кнопка "Яйцо" (если она называется BtnEgg)
		if obj.Name == "BtnEgg" then
			obj.Activated:Connect(function()
				teleportTo(7536.6, 19.7, 21943.4)
			end)
		end
		
		-- Кнопка "фарм" (если называется BtnFarm)
		if obj.Name == "BtnFarm" then
			obj.Activated:Connect(function()
				teleportTo(7540.5, 16.2, 21967.8)
			end)
		end
	end
end

-- Кнопка закрытия (должна называться BtnClose)
local closeBtn = frame:FindFirstChild("BtnClose")
if closeBtn then
	closeBtn.Activated:Connect(function()
		gui.Enabled = false -- Лучше отключать GUI, а не удалять
	end)
else
	warn("Не найдена кнопка BtnClose в MainFrame. Добавь её и назови правильно.")
end

-- Обработка событий от сервера
DoorSystemEvent.OnClientEvent:Connect(function(eventType, data)
	if eventType == "doorOpened" then
		local id = data.doorId
		local duration = data.duration
		
		-- АВТОТЕЛЕПОРТ: если кнопка существует, телепортируем игрока
		if buttons[id] then
			task.wait(0.5) 
			-- Здесь можно добавить автотелепорт к двери, если хочешь
			-- teleportTo(doorPoints[id].X, doorPoints[id].Y, doorPoints[id].Z)
		end
		
		-- Запускаем таймер для этой кнопки
		if timerConnections[id] then timerConnections[id]:Disconnect() end
		timerConnections[id] = RunService.Heartbeat:Connect(function()
			local timeLeft = duration - (tick() - data.openTime)
			updateButtonTimer(buttons[id], timeLeft)
			
			if timeLeft <= 0 then
				timerConnections[id]:Disconnect()
				buttons[id].Text = "🚪 Дверь закрыта"
				buttons[id].BackgroundColor3 = Color3.fromRGB(100, 100, 100)
			end
		end)
		
	elseif eventType == "doorClosed" then
		local id = data.doorId
		if timerConnections[id] then timerConnections[id]:Disconnect() end
		if buttons[id] then
			buttons[id].Text = "🚪 Дверь закрыта"
			buttons[id].BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		end
		
	elseif eventType == "allowTeleport" then
		teleportTo(data.position.X, data.position.Y, data.position.Z)
		print("Телепорт разрешён сервером!")
		
	elseif eventType == "teleportDenied" then
		warn("Нельзя телепортироваться: дверь закрыта или выключена!")
	end
end)
