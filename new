local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local DoorSystemEvent = ReplicatedStorage:WaitForChild("DoorSystemEvent")

local gui = Instance.new("ScreenGui")
gui.Name = "TeleportGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 430, 0, 355)
frame.Position = UDim2.new(0, 20, 0.3, 0)
frame.BackgroundColor3 = Color3.fromRGB(45, 35, 65)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local function teleportTo(x, y, z)
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")
	root.CFrame = CFrame.new(x, y, z)
end

-- Таблица кнопок для хранения ссылок и таймеров
local buttons = {}
local timerConnections = {}

local function updateButtonTimer(btn, timeLeft)
	if timeLeft <= 0 then
		btn.Text = "🚪 Дверь открыта!"
		btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Зелёный
	else
		local mins = math.floor(timeLeft / 60)
		local secs = timeLeft % 60
		btn.Text = string.format("🚪 Откроется через: %02d:%02d", mins, secs)
		btn.BackgroundColor3 = Color3.fromRGB(200, 100, 0) -- Оранжевый
	end
end

local function createButton(xPos, yPos, text, doorId)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 200, 0, 55)
	btn.Position = UDim2.new(0, xPos, 0, yPos)
	btn.Text = text
	btn.TextScaled = true
	btn.Parent = frame
	
	buttons[doorId] = btn
	
	btn.Activated:Connect(function()
		-- Запрос на телепорт серверу
		DoorSystemEvent:FireServer("requestTeleport", {doorId = doorId})
	end)
	
	return btn
end

