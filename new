-- Обработка событий от сервера
DoorSystemEvent.OnClientEvent:Connect(function(eventType, data)
	if eventType == "doorOpened" then
		local id = data.doorId
		local duration = data.duration
		
		-- АВТОТЕЛЕПОРТ: если кнопка существует, телепортируем игрока
		if buttons[id] then
			-- Небольшая задержка, чтобы анимация успела проиграться, или сразу
			task.wait(0.5) 
			-- Координаты можно взять из той же таблицы, что и на сервере, но здесь мы просто реагируем
			-- Для точного телепорта лучше, чтобы сервер присылал позицию (см. allowTeleport ниже)
		end
		
		-- Запускаем таймер для этой кнопки
		if timerConnections[id] then timerConnections[id]:Disconnect() end
		timerConnections[id] = RunService.Heartbeat:Connect(function()
			local timePassed = tick() - data.openTime -- Упрощённо, лучше хранить время на клиенте отдельно
			-- В реальном проекте время лучше считать на основе данных сервера, чтобы рассинхрона не было
			-- Но для учебного примера хватит и так
			local timeLeft = duration - (tick() - data.openTime)
			updateButtonTimer(buttons[id], timeLeft)
			
			if timeLeft <= 0 then
				timerConnections[id]:Disconnect()
				buttons[id].Text = "🚪 Дверь закрыта"
				buttons[id].BackgroundColor3 = Color3.fromRGB(100, 100, 100)
			end
		end)
		
	elseif eventType == "doorClosed" then
		local id = data.doorId
		if timerConnections[id] then timerConnections[id]:Disconnect() end
		if buttons[id] then
			buttons[id].Text = "🚪 Дверь закрыта"
			buttons[id].BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		end
		
	elseif eventType == "allowTeleport" then
		-- Сервер разрешил телепорт и прислал координаты
		teleportTo(data.position.X, data.position.Y, data.position.Z)
		print("Телепорт разрешён сервером!")
		
	elseif eventType == "teleportDenied" then
		warn("Нельзя телепортироваться: дверь закрыта или выключена!")
	end
end)
