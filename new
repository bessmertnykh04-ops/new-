local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- Находим кнопку по имени
local gui = script.Parent
local frame = gui:FindFirstChild("MainFrame")
if not frame then
	warn("[КРИТИЧНО] Нет MainFrame в SimpleMenu! Проверь имена.")
	return
end

local btn = frame:FindFirstChild("BtnTest")
if not btn then
	warn("[КРИТИЧНО] Нет кнопки BtnTest! Проверь имя.")
	return
end

-- Функция телепорта
local function teleportTo(x, y, z)
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")
	root.CFrame = CFrame.new(x, y, z)
end

-- Логика кнопки
btn.Activated:Connect(function()
	teleportTo(7536.6, 19.7, 21943.4)
	print("ТЕЛЕПОРТ СРАБОТАЛ!")
end)

print("Меню SimpleMenu загружено.")
